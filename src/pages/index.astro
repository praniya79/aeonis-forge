---
import Layout from '../layouts/Layout.astro';
import { site, products, galleryImages } from '../content';

const whatsappHref = `https://wa.me/${site.whatsapp.numberE164}?text=${encodeURIComponent('Hi Art Engine! I need a quote. My wall size is __ and location is __.')}`;
---

<Layout>
  <section class="mx-auto max-w-6xl px-5 py-14 md:py-20">
    <div class="grid gap-10 md:grid-cols-12 md:items-center">
      <div class="md:col-span-6">
        <p class="mb-4 inline-flex rounded-full border border-black/10 bg-white/40 px-3 py-1 text-xs tracking-wide text-black/70">
          Colombo + Gampaha • Build & Install • {site.leadTime}
        </p>
        <h1 class="text-balance text-4xl font-semibold tracking-tight md:text-6xl">{site.tagline}</h1>
        <p class="mt-5 text-pretty text-base leading-relaxed text-black/70 md:text-lg">
          {site.subtagline}
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/products" class="rounded-full bg-[#1A1F24] px-5 py-3 text-sm font-semibold text-[#EFEDE4] hover:bg-black">Shop Standard Designs</a>
          <a href={whatsappHref} class="rounded-full border border-black/15 bg-white/30 px-5 py-3 text-sm font-semibold text-black/80 hover:bg-white/50">Get a Quote (WhatsApp)</a>
        </div>
        <div class="mt-8 grid max-w-xl grid-cols-3 gap-4 text-sm">
          <div class="rounded-2xl border border-black/10 bg-white/30 p-4">
            <div class="text-xs text-black/60">Halo</div>
            <div class="mt-1 font-medium">From LKR 30,000</div>
          </div>
          <div class="rounded-2xl border border-black/10 bg-white/30 p-4">
            <div class="text-xs text-black/60">Wave</div>
            <div class="mt-1 font-medium">From LKR 25,000</div>
          </div>
          <div class="rounded-2xl border border-black/10 bg-white/30 p-4">
            <div class="text-xs text-black/60">Modular</div>
            <div class="mt-1 font-medium">From LKR 10,000</div>
          </div>
        </div>
      </div>

      <div class="md:col-span-6">
        <div class="relative overflow-hidden rounded-3xl border border-black/10 bg-white/30">
          <img src={'/images/product-23.jpg'} alt="Art Engine feature" class="aspect-[4/3] w-full object-cover" loading="eager" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/25 via-transparent to-transparent"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-16">
    <div class="mb-6 flex items-end justify-between gap-6">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight">Featured</h2>
        <p class="mt-2 text-sm text-black/70">Standard designs for quick purchase, and custom builds for exact-fit walls.</p>
      </div>
      <a class="text-sm font-medium text-black/70 underline underline-offset-4 hover:text-black" href="/products">View all</a>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {products.map((p) => (
        <a href={`/products/${p.slug}`} class="group rounded-3xl border border-black/10 bg-white/30 p-4 transition hover:bg-white/40">
          <div class="overflow-hidden rounded-2xl border border-black/10">
            <img src={p.image} alt={p.name} class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-[1.02]" loading="lazy" />
          </div>
          <div class="mt-4 flex items-start justify-between gap-4">
            <div>
              <div class="text-xs uppercase tracking-wide text-black/50">{p.series} Series</div>
              <div class="mt-1 text-base font-semibold">{p.name}</div>
            </div>
            <div class="text-right text-sm font-semibold">From LKR {p.priceFromLkr.toLocaleString('en-US')}</div>
          </div>
          <p class="mt-2 text-sm text-black/70">{p.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="border-y border-black/10 bg-white/10">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <div class="grid gap-10 md:grid-cols-12">
        <div class="md:col-span-5">
          <h2 class="text-2xl font-semibold tracking-tight">How it works</h2>
          <p class="mt-2 text-sm text-black/70">A simple flow, with clean communication from design to installation.</p>
        </div>
        <div class="md:col-span-7">
          <div class="grid gap-4 md:grid-cols-3">
            <div class="rounded-2xl border border-black/10 bg-white/30 p-5">
              <div class="text-xs text-black/60">Step 01</div>
              <div class="mt-2 font-semibold">Send your wall</div>
              <div class="mt-2 text-sm text-black/70">Photo/video + wall size (W×H) + location.</div>
            </div>
            <div class="rounded-2xl border border-black/10 bg-white/30 p-5">
              <div class="text-xs text-black/60">Step 02</div>
              <div class="mt-2 font-semibold">Choose a style</div>
              <div class="mt-2 text-sm text-black/70">Halo / Wave / Modular — finish + LED glow.</div>
            </div>
            <div class="rounded-2xl border border-black/10 bg-white/30 p-5">
              <div class="text-xs text-black/60">Step 03</div>
              <div class="mt-2 font-semibold">Build & install</div>
              <div class="mt-2 text-sm text-black/70">We fabricate, test lighting, and install neatly.</div>
            </div>
          </div>
          <div class="mt-6">
            <a href={whatsappHref} class="inline-flex rounded-full bg-[#5E7A5A] px-5 py-3 text-sm font-semibold text-white hover:brightness-95">Message on WhatsApp</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="mb-6 flex items-end justify-between gap-6">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight">Gallery</h2>
        <p class="mt-2 text-sm text-black/70">Zen forms, warm light, and living greens.</p>
      </div>
      <a class="text-sm font-medium text-black/70 underline underline-offset-4 hover:text-black" href="/gallery">Explore</a>
    </div>

    <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
      {galleryImages.slice(0, 8).map((src) => (
        <div class="overflow-hidden rounded-2xl border border-black/10 bg-white/30">
          <img src={src} alt="Art Engine gallery" class="aspect-square w-full object-cover" loading="lazy" />
        </div>
      ))}
    </div>
  </section>
</Layout>
