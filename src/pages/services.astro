---
import Layout from '../layouts/Layout.astro';
import { site } from '../content';

const whatsappHref = `https://wa.me/${site.whatsapp.numberE164}?text=${encodeURIComponent('Hi Art Engine! I need a quote. My wall size is __ and location is __. Style: (Halo/Wave/Modular).')}`;
---

<Layout title="Services">
  <section class="mx-auto max-w-6xl px-5 py-14">
    <div class="max-w-2xl">
      <h1 class="text-4xl font-semibold tracking-tight">Services</h1>
      <p class="mt-4 text-black/70">
        We design, build & install custom wall features with warm LED glow. Clean finishes, calm geometry, and a premium minimalist aesthetic.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <div class="rounded-3xl border border-black/10 bg-white/30 p-6">
        <div class="text-xs uppercase tracking-wide text-black/50">Halo Series</div>
        <div class="mt-2 text-lg font-semibold">Niches & Glow Panels</div>
        <p class="mt-2 text-sm text-black/70">Circular, half-moon, and arched halo forms with warm backlighting.</p>
      </div>
      <div class="rounded-3xl border border-black/10 bg-white/30 p-6">
        <div class="text-xs uppercase tracking-wide text-black/50">Wave Series</div>
        <div class="mt-2 text-lg font-semibold">Sculptural Shelves</div>
        <p class="mt-2 text-sm text-black/70">Soft curves designed as functional art — perfect for plants and objects.</p>
      </div>
      <div class="rounded-3xl border border-black/10 bg-white/30 p-6">
        <div class="text-xs uppercase tracking-wide text-black/50">Modular Series</div>
        <div class="mt-2 text-lg font-semibold">Custom Layout Systems</div>
        <p class="mt-2 text-sm text-black/70">Clean grids and modules built to your wall size and use-case.</p>
      </div>
    </div>

    <div class="mt-12 grid gap-10 md:grid-cols-12">
      <div class="md:col-span-6">
        <h2 class="text-2xl font-semibold tracking-tight">How to order</h2>
        <ol class="mt-4 space-y-3 text-sm text-black/70">
          <li><span class="font-semibold text-black">1.</span> Send a wall photo/video + wall size (W×H) + location.</li>
          <li><span class="font-semibold text-black">2.</span> Choose style (Halo/Wave/Modular), finish (White/Wood/Black), and LED preference.</li>
          <li><span class="font-semibold text-black">3.</span> We confirm details within 24 hours and share the final quotation.</li>
          <li><span class="font-semibold text-black">4.</span> Fabrication + testing + installation. Lead time: {site.leadTime}.</li>
        </ol>
        <div class="mt-6">
          <a href={whatsappHref} class="inline-flex rounded-full bg-[#1A1F24] px-5 py-3 text-sm font-semibold text-[#EFEDE4] hover:bg-black">Get a Quote on WhatsApp</a>
        </div>
      </div>

      <div class="md:col-span-6">
        <h2 class="text-2xl font-semibold tracking-tight">Service area & notes</h2>
        <div class="mt-4 rounded-3xl border border-black/10 bg-white/30 p-6 text-sm text-black/70">
          <ul class="space-y-2">
            <li><span class="font-semibold text-black">Colombo:</span> installation available</li>
            <li><span class="font-semibold text-black">Gampaha:</span> + travel fee {site.travelFeeGampaha}</li>
            <li><span class="font-semibold text-black">Power:</span> a nearby power point is recommended for LED features</li>
            <li><span class="font-semibold text-black">Final pricing:</span> depends on wall condition, size, finish, and complexity</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>
