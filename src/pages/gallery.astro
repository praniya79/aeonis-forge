---
import Layout from '../layouts/Layout.astro';
import { galleryImages } from '../content';
---

<Layout title="Gallery">
  <section class="mx-auto max-w-6xl px-5 py-14">
    <div class="max-w-2xl">
      <h1 class="text-4xl font-semibold tracking-tight">Gallery</h1>
      <p class="mt-4 text-black/70">Zen forms, warm light, and living greens — a selection of Art Engine inspirations and signature directions.</p>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-4">
      {galleryImages.map((src) => (
        <div class="group overflow-hidden rounded-2xl border border-black/10 bg-white/30">
          <img
            src={src}
            alt="Art Engine gallery"
            class="aspect-square w-full object-cover transition duration-500 group-hover:scale-[1.02]"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </section>
</Layout>
